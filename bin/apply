#!/usr/bin/env bash
# Session tuner for the ASUS Vivobook S14 Copilot+ (S5406SA, Core Ultra 7 258V).
# Called from this plugin's service and from a cloned Omarchy power menu.
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
PLUGIN_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

MONITOR="${OMARCHY_VIVOBOOK_MONITOR:-eDP-1}"
RES="2880x1800"
SCALE="${OMARCHY_VIVOBOOK_SCALE:-2}"
BAT_END="/sys/class/power_supply/BAT0/charge_control_end_threshold"
CHARGE_HELPER=""
CHARGE_HELPER_PKG="/usr/lib/vivobook-s14-copilot/set-charge-limit"
CHARGE_HELPER_LEGACY="/usr/local/lib/vivobook-s14-copilot/set-charge-limit"
CHARGE_PKGDIR_REL="packaging/vivobook-s14-copilot-charge"
THERMAL="/sys/devices/platform/asus-nb-wmi/throttle_thermal_policy"
KBD_LED="asus::kbd_backlight"
CHROMIUM_FLAGS="${XDG_CONFIG_HOME:-$HOME/.config}/chromium-flags.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/vivobook-s14-copilot"
LEGACY_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-vivobook-profile"
STATE_FILE="$STATE_DIR/current"
KBD_FILE="$STATE_DIR/kbd-saved"
LEGACY_STATE_FILE="$LEGACY_STATE_DIR/current"

VAAPI_ENABLE_FEATURES="VaapiVideoDecoder,VaapiIgnoreDriverChecks"
VAAPI_DISABLE_FEATURES="UseChromeOSDirectVideoDecoder"

REMEMBER=1
TUNE_ONLY=0
SOURCE=""
HAVE_TTY=0
[[ -t 0 ]] && HAVE_TTY=1

usage() {
  cat <<'EOF'
Usage: apply [--remember|--no-remember] [--tune-only] [--source ac|battery]
             <performance|balanced|power-saver|autodetect|unplug>
       apply status
       apply --shell-status
       apply charge <80|100>
       apply setup
       apply helper-ready
       apply teardown

Maps Omarchy power-profile buttons onto Vivobook S14 Copilot+ extras.
Per-profile knobs live in ~/.config/omarchy/vivobook-s14-copilot.json
and can be edited from the plugin's Customize panel.

Defaults:
  performance  120 Hz, animations on, charge 100%, kbd restored
  balanced     120 Hz, animations on, charge 80%,  kbd restored
  power-saver  60 Hz,  animations off, charge 80%, kbd off
  unplug       force power-saver extras unless autoBattery is off

Charge limit writes go through a separately installed, root-owned
package (`vivobook-s14-copilot-charge`). This plugin never pkexecs
its checkout. Install from
https://github.com/paulogeyer/vivobook-s14-copilot-charge (makepkg -si).
The pack does not drain down to 80%; the limit only stops charging past
that point.

--remember (default) also stores the PPD choice for AC vs battery via
omarchy-powerprofiles-set. --tune-only only applies extras (the profile
already changed). Does not wrap the packaged omarchy-powerprofiles-set binary.
EOF
}

on_battery() {
  local raw
  raw=$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null || true)
  [[ $raw == "b true" ]]
}

resolve_source() {
  if [[ -n $SOURCE ]]; then
    printf '%s\n' "$SOURCE"
    return
  fi
  if on_battery; then
    echo battery
  else
    echo ac
  fi
}

map_profile() {
  case "$1" in
    performance|balanced|power-saver) printf '%s\n' "$1" ;;
    battery) echo power-saver ;;
    *) return 1 ;;
  esac
}

current_ppd() {
  powerprofilesctl get 2>/dev/null || echo balanced
}

save_state() {
  mkdir -p "$STATE_DIR" "$LEGACY_STATE_DIR"
  printf '%s\n' "$1" >"$STATE_FILE"
  case "$1" in
    power-saver) printf '%s\n' battery >"$LEGACY_STATE_FILE" ;;
    *) printf '%s\n' "$1" >"$LEGACY_STATE_FILE" ;;
  esac
}

hypr_eval() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl eval "$1" >/dev/null
}

set_refresh() {
  local hz="$1" cur
  command -v hyprctl >/dev/null 2>&1 || return 0
  cur=$(current_refresh || true)
  if [[ -n $cur && $cur == "$hz" ]]; then
    echo "display: ${MONITOR} already ${hz} Hz"
    return 0
  fi
  # xe on this Lunar Lake panel hangs RCS if we modeset 60↔120 while
  # Hyprland is mid-pageflip (BugReports/2026-09-11-hyprland-xe-hang*).
  # Blank first so no frames are in flight, then restore DPMS.
  hyprctl dispatch dpms off "$MONITOR" >/dev/null 2>&1 || hyprctl dispatch dpms off >/dev/null 2>&1 || true
  sleep 0.45
  hypr_eval "hl.monitor({ output = \"${MONITOR}\", mode = \"${RES}@${hz}\", position = \"0x0\", scale = ${SCALE} })" || true
  sleep 0.35
  hyprctl dispatch dpms on "$MONITOR" >/dev/null 2>&1 || hyprctl dispatch dpms on >/dev/null 2>&1 || true
  echo "display: ${MONITOR} ${RES}@${hz} scale ${SCALE} (was ${cur:-unknown})"
}

set_animations() {
  local enabled=true
  [[ $1 == off ]] && enabled=false
  hypr_eval "hl.config({ animations = { enabled = ${enabled} } })"
  echo "animations: $1"
}

try_write() {
  local dest="$1" value="$2"
  [[ -e $dest ]] || return 0
  if [[ -r $dest && $(cat "$dest") == "$value" ]]; then
    return 0
  fi
  if [[ -w $dest ]]; then
    printf '%s\n' "$value" >"$dest"
  fi
}

charge_now() {
  local path="$1"
  [[ -r $path ]] || return 1
  tr -d ' \n' <"$path"
}

resolve_charge_helper() {
  if [[ -x $CHARGE_HELPER_PKG ]]; then
    CHARGE_HELPER=$CHARGE_HELPER_PKG
  elif [[ -x $CHARGE_HELPER_LEGACY ]]; then
    CHARGE_HELPER=$CHARGE_HELPER_LEGACY
  else
    CHARGE_HELPER=""
  fi
}

charge_helper_ready() {
  resolve_charge_helper
  [[ -n $CHARGE_HELPER && -x $CHARGE_HELPER ]] && sudo -n "$CHARGE_HELPER" --ok >/dev/null 2>&1
}

charge_pkg_dir() {
  printf '%s\n' "$PLUGIN_DIR/$CHARGE_PKGDIR_REL"
}

ensure_charge_helper() {
  charge_helper_ready && return 0
  [[ ${OMARCHY_VIVOBOOK_SKIP_CHARGE_SETUP:-} == 1 ]] && return 1
  return 1
}

set_charge() {
  local pct="$1" now
  [[ $pct == 80 || $pct == 100 ]] || { echo "charge: 80|100" >&2; return 2; }
  [[ -e $BAT_END ]] || { echo "charge limit: unavailable"; return 0; }
  now=$(charge_now "$BAT_END" || true)
  if [[ $now == "$pct" ]]; then
    echo "charge limit: ${pct}% (already set)"
    return 0
  fi
  if [[ -w $BAT_END ]]; then
    printf '%s\n' "$pct" >"$BAT_END"
    echo "charge limit: $(charge_now "$BAT_END")%"
    return 0
  fi
  if charge_helper_ready && sudo -n "$CHARGE_HELPER" "$pct"; then
    return 0
  fi
  if ensure_charge_helper && sudo -n "$CHARGE_HELPER" "$pct"; then
    return 0
  fi
  echo "charge limit: not applied (want ${pct}%; git clone https://github.com/paulogeyer/vivobook-s14-copilot-charge.git && cd vivobook-s14-copilot-charge && makepkg -si)" >&2
  return 0
}

cmd_charge() {
  set_charge "$1"
}

cmd_helper_ready() {
  if charge_helper_ready; then
    return 0
  fi
  return 1
}

cmd_setup() {
  local profile pkgdir ans
  if charge_helper_ready; then
    echo "charge helper: $CHARGE_HELPER"
    profile=$(map_profile "$(current_ppd)" || echo balanced)
    load_profile_opts "$profile"
    if [[ ${CHARGE:-} != skip && -n ${CHARGE:-} ]]; then
      set_charge "$CHARGE"
    fi
    return 0
  fi
  echo "Charge hold uses package vivobook-s14-copilot-charge (root-owned helper)."
  echo "This plugin does not pkexec its checkout. Install with:"
  echo "  git clone https://github.com/paulogeyer/vivobook-s14-copilot-charge.git"
  echo "  cd vivobook-s14-copilot-charge && makepkg -si"
  pkgdir=$(charge_pkg_dir)
  if (( HAVE_TTY )) && [[ -f $pkgdir/PKGBUILD ]]; then
    read -r -p "Build and install from $pkgdir now? [y/N] " ans
    if [[ ${ans,,} == y || ${ans,,} == yes ]]; then
      ( cd "$pkgdir" && makepkg -si )
      charge_helper_ready || return 1
      echo "charge helper: $CHARGE_HELPER"
      profile=$(map_profile "$(current_ppd)" || echo balanced)
      load_profile_opts "$profile"
      if [[ ${CHARGE:-} != skip && -n ${CHARGE:-} ]]; then
        set_charge "$CHARGE"
      fi
      return 0
    fi
  fi
  return 1
}

cmd_teardown() {
  if pacman -Q vivobook-s14-copilot-charge >/dev/null 2>&1; then
    echo "Remove with: sudo pacman -R vivobook-s14-copilot-charge"
    if (( HAVE_TTY )); then
      sudo pacman -R vivobook-s14-copilot-charge
    fi
    return
  fi
  echo "package vivobook-s14-copilot-charge is not installed"
}

set_thermal() {
  # asus-nb-wmi: 0 default, 1 overboost, 2 silent
  local policy="$1"
  try_write "$THERMAL" "$policy"
  if [[ -r $THERMAL ]]; then
    echo "thermal policy: $(cat "$THERMAL")"
  fi
}

kbd_get() {
  brightnessctl --device="$KBD_LED" get 2>/dev/null || echo ""
}

kbd_set() {
  local value="$1"
  [[ -n $value ]] || return 0
  brightnessctl --device="$KBD_LED" set "$value" >/dev/null 2>&1 || true
}

set_kbd() {
  local mode="$1"
  local cur
  cur=$(kbd_get)
  [[ -n $cur ]] || { echo "keyboard backlight: unavailable"; return 0; }
  mkdir -p "$STATE_DIR"
  if [[ $mode == off ]]; then
    if [[ $cur != 0 ]]; then
      printf '%s\n' "$cur" >"$KBD_FILE"
    fi
    kbd_set 0
    echo "keyboard backlight: off"
  else
    local restore="$cur"
    if [[ -f $KBD_FILE ]]; then
      restore=$(cat "$KBD_FILE")
    fi
    [[ -n $restore ]] || restore="$cur"
    kbd_set "$restore"
    echo "keyboard backlight: $(kbd_get)"
  fi
}

chromium_features_line() {
  local file="$1" key="$2"
  [[ -f $file ]] || { echo ""; return; }
  awk -v k="$key" 'index($0, k"=")==1 { sub(/^[^=]+=/,""); print; exit }' "$file"
}

ensure_vaapi() {
  [[ -f $CHROMIUM_FLAGS ]] || return 0
  grep -q 'VaapiVideoDecoder' "$CHROMIUM_FLAGS" 2>/dev/null && return 0
  mkdir -p "$(dirname "$CHROMIUM_FLAGS")"
  touch "$CHROMIUM_FLAGS"
  local tmp enable disable
  tmp=$(mktemp)
  enable=$(chromium_features_line "$CHROMIUM_FLAGS" --enable-features)
  disable=$(chromium_features_line "$CHROMIUM_FLAGS" --disable-features)
  enable=$(python3 -c '
import sys
seen=set(); out=[]
for part in sys.argv[1:]:
    for item in part.split(","):
        item=item.strip()
        if item and item not in seen:
            seen.add(item); out.append(item)
print(",".join(out))
' "$enable" "$VAAPI_ENABLE_FEATURES")
  disable=$(python3 -c '
import sys
seen=set(); out=[]
for part in sys.argv[1:]:
    for item in part.split(","):
        item=item.strip()
        if item and item not in seen:
            seen.add(item); out.append(item)
print(",".join(out))
' "$disable" "$VAAPI_DISABLE_FEATURES")
  awk '
    $0 ~ /^--enable-features=/ { next }
    $0 ~ /^--disable-features=/ { next }
    { print }
  ' "$CHROMIUM_FLAGS" >"$tmp"
  [[ -n $enable ]] && printf '%s\n' "--enable-features=${enable}" >>"$tmp"
  [[ -n $disable ]] && printf '%s\n' "--disable-features=${disable}" >>"$tmp"
  mv "$tmp" "$CHROMIUM_FLAGS"
  echo "chromium VAAPI: on"
}

remember_ppd() {
  local profile="$1" source
  source=$(resolve_source)
  if command -v omarchy-powerprofiles-set >/dev/null; then
    omarchy-powerprofiles-set "$source" "$profile"
  else
    powerprofilesctl set "$profile"
  fi
  echo "power profile: $(powerprofilesctl get) ($source)"
}

set_ppd_only() {
  powerprofilesctl set "$1"
  echo "power profile: $(powerprofilesctl get)"
}

current_refresh() {
  hyprctl monitors -j 2>/dev/null | python3 -c '
import json,sys
try:
    mons=json.load(sys.stdin)
except Exception:
    sys.exit(0)
for m in mons:
    if m.get("name")=="'"$MONITOR"'":
        print(int(round(float(m.get("refreshRate") or 0))))
        break
' 2>/dev/null || true
}

cmd_status() {
  local last="(none)"
  [[ -f $STATE_FILE ]] && last=$(cat "$STATE_FILE")
  echo "last profile:     $last"
  echo "power profile:    $(current_ppd)"
  echo "acpi platform:    $(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo unknown)"
  echo "cpu governor:     $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo unknown)"
  echo "cpu epp:          $(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo unknown)"
  echo "thermal policy:   $(cat "$THERMAL" 2>/dev/null || echo unknown)"
  echo "refresh:          $(current_refresh || echo unknown) Hz"
  echo "battery:          $(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo unknown)% $(cat /sys/class/power_supply/BAT0/status 2>/dev/null || true)"
  echo "charge limit:     $(cat "$BAT_END" 2>/dev/null || echo unknown)%"
  if charge_helper_ready; then
    echo "charge helper:    ready ($CHARGE_HELPER)"
  elif [[ -n $CHARGE_HELPER && -x $CHARGE_HELPER ]]; then
    echo "charge helper:    installed but not passwordless ($CHARGE_HELPER)"
  else
    echo "charge helper:    missing (https://github.com/paulogeyer/vivobook-s14-copilot-charge)"
  fi
  echo "keyboard light:   $(kbd_get || echo unknown)"
  echo "animations:       $(hyprctl getoption animations:enabled -j 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print("on" if d.get("bool") is True or d.get("int")==1 else "off")' 2>/dev/null || echo unknown)"
}

cmd_shell_status() {
  printf 'profile\t%s\n' "$( [[ -f $STATE_FILE ]] && cat "$STATE_FILE" || echo none )"
  printf 'ppd\t%s\n' "$(current_ppd)"
  printf 'refresh\t%s Hz\n' "$(current_refresh || echo "?")"
  printf 'charge\t%s%%\n' "$(cat "$BAT_END" 2>/dev/null || echo "?")"
  printf 'kbd\t%s\n' "$(kbd_get || echo "?")"
  printf 'thermal\t%s\n' "$(cat "$THERMAL" 2>/dev/null || echo "?")"
}

load_profile_opts() {
  REFRESH=""
  ANIMATIONS=""
  CHARGE=""
  KEYBOARD=""
  THERMAL_POLICY=""
  VAAPI="on"
  AUTO_BATTERY="on"
  local line key val
  while IFS= read -r line; do
    [[ $line == *=* ]] || continue
    key=${line%%=*}
    val=${line#*=}
    case "$key" in
      refresh) REFRESH=$val ;;
      animations) ANIMATIONS=$val ;;
      charge) CHARGE=$val ;;
      keyboard) KEYBOARD=$val ;;
      thermal) THERMAL_POLICY=$val ;;
      vaapi) VAAPI=$val ;;
      auto_battery) AUTO_BATTERY=$val ;;
    esac
  done < <(python3 "$PLUGIN_DIR/bin/config" env "$1")
}

apply_extras() {
  local profile="$1"
  load_profile_opts "$profile"
  if [[ ${REFRESH:-} != skip && -n ${REFRESH:-} ]]; then
    set_refresh "$REFRESH" || true
  fi
  if [[ ${ANIMATIONS:-} != skip && -n ${ANIMATIONS:-} ]]; then
    set_animations "$ANIMATIONS" || true
  fi
  if [[ ${KEYBOARD:-} != skip && -n ${KEYBOARD:-} ]]; then
    set_kbd "$KEYBOARD" || true
  fi
  if [[ ${THERMAL_POLICY:-} != skip && -n ${THERMAL_POLICY:-} ]]; then
    set_thermal "$THERMAL_POLICY" || true
  fi
  if [[ ${CHARGE:-} != skip && -n ${CHARGE:-} ]]; then
    set_charge "$CHARGE" || true
  fi
  if [[ ${VAAPI:-} == on ]]; then
    ensure_vaapi || true
  fi
  save_state "$profile"
}

auto_battery_enabled() {
  if [[ ${OMARCHY_VIVOBOOK_AUTO_BATTERY:-} == 0 ]]; then
    return 1
  fi
  load_profile_opts power-saver
  [[ ${AUTO_BATTERY:-on} == on ]]
}

cmd_unplug() {
  if auto_battery_enabled; then
    TUNE_ONLY=0
    REMEMBER=1
    SOURCE=battery
    apply_profile power-saver
  else
    TUNE_ONLY=1
    REMEMBER=0
    apply_profile "$(map_profile "$(current_ppd)" || echo balanced)"
  fi
}

apply_profile() {
  local profile="$1"
  if (( TUNE_ONLY )); then
    apply_extras "$profile"
  elif (( REMEMBER )); then
    remember_ppd "$profile"
    apply_extras "$profile"
  else
    set_ppd_only "$profile"
    apply_extras "$profile"
  fi
  echo "profile: $profile"
}

main() {
  local args=()
  while (( $# )); do
    case "$1" in
      --remember) REMEMBER=1 ;;
      --no-remember) REMEMBER=0 ;;
      --tune-only) TUNE_ONLY=1; REMEMBER=0 ;;
      --source)
        SOURCE="${2:-}"
        [[ -n $SOURCE ]] || { echo "--source needs ac or battery" >&2; exit 2; }
        shift
        ;;
      --source=*) SOURCE="${1#--source=}" ;;
      -h|--help) usage; return 0 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  case "${SOURCE}" in
    ""|ac|battery) ;;
    *) echo "source: ac|battery" >&2; exit 2 ;;
  esac

  local cmd="${args[0]:-}"
  case "$cmd" in
    "" ) usage ;;
    status) cmd_status ;;
    --shell-status|shell-status) cmd_shell_status ;;
    charge)
      [[ ${args[1]:-} == 80 || ${args[1]:-} == 100 ]] || { echo "charge: 80|100" >&2; exit 2; }
      cmd_charge "${args[1]}"
      ;;
    setup) cmd_setup ;;
    helper-ready) cmd_helper_ready ;;
    teardown) cmd_teardown ;;
    autodetect)
      apply_profile "$(map_profile "$(current_ppd)" || echo balanced)"
      ;;
    unplug)
      cmd_unplug
      ;;
    performance|balanced|power-saver|battery)
      apply_profile "$(map_profile "$cmd")"
      ;;
    *)
      echo "unknown command: $cmd" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
